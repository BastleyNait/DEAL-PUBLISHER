# Mismo proyecto que DEAL HUNTER. Dashboard → Project Settings → API.
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
# La service role, no el anon key: este worker lee y escribe `publications`
# directo, sin pasar por una Edge Function.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Ciudades donde se publica cada laptop (una publicación por ciudad, para
# llegar a más gente), separadas por punto y coma. Si una falla, al reintentar
# sigue con las que faltan sin repetir las ya publicadas.
FB_LOCATIONS=Lima, Peru;Arequipa, Peru;Moquegua, Peru
# Pausa en segundos entre una ciudad y la siguiente del mismo ítem.
FB_LOCATION_GAP_SECONDS=30

# true (default): llena el formulario entero y se detiene antes del botón
# final de publicar, esperando que apretés Enter en esta terminal. Ponelo en
# false recién cuando confíes en que el formulario queda bien sin mirarlo.
FB_CONFIRM_BEFORE_POST=true

# true: llena el formulario, guarda una captura en runs/ y se detiene ahí —
# ni siquiera pide confirmación. Para probar el llenado sin arriesgarte a
# publicar de más mientras ajustás selectores.
FB_DRY_RUN=false

# Cada cuánto revisa la cola por jobs nuevos, en segundos.
POLL_INTERVAL_SECONDS=15
